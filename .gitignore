###############################
# Build / Saída de compilação
###############################

# Arquivos .class e crash logs da JVM
*.class
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# (Wrappers do Maven/Gradle DEVEM ser versionados:
#  mvnw, mvnw.cmd, gradlew, gradlew.bat, .mvn/, gradle/wrapper/)

